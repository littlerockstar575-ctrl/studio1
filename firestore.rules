/**
 * @file Firestore Security Rules for GoalForge
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model, where users can only access and modify their own data. Public read access is granted to challenge templates.
 *
 * Data Structure:
 * - /users/{userId}: User profile data, accessible only by the owning user.
 * - /users/{userId}/goals/{goalId}: Goals belonging to a specific user, accessible only by the owning user.
 * - /challengeTemplates/{challengeTemplateId}: Publicly accessible challenge templates.
 * - /users/{userId}/userChallenges/{userChallengeId}: User-specific challenges, accessible only by the owning user.
 *
 * Key Security Decisions:
 * - User data is strictly private, preventing unauthorized access to user profiles and their associated data.
 * - Challenge templates are publicly readable to allow all users to view available challenges.
 * - Subcollections are secured based on the parent user ID, enforcing strong ownership.
 *
 * Denormalization for Authorization:
 * The Firestore structure utilizes path-based ownership, eliminating the need for `get()` calls in security rules. User ID is encoded in the document path for authorization.
 *
 * Structural Segregation:
 * Challenge templates are stored in a separate top-level collection to allow for public read access without compromising the security of user-specific data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles. Only the user can read/write their own profile.
     * @path /users/{userId}
     * @allow (get, create, update, delete, list) if the user is the owner.
     * @deny (get, create, update, delete, list) if the user is not the owner.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      // Verified user identity
      function isSignedIn() {
        return request.auth != null;
      }

      // Is the user the owner?
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Is the user the existing owner?
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Secure goals associated with a specific user. Only the owning user can access these goals.
     * @path /users/{userId}/goals/{goalId}
     * @allow (get, create, update, delete, list) if the user is the owner.
     * @deny (get, create, update, delete, list) if the user is not the owner.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/goals/{goalId} {
       // Verified user identity
      function isSignedIn() {
        return request.auth != null;
      }

      // Is the user the owner?
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Is the user the existing owner?
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Secure challenge templates. Accessible by all users to fetch and populate challenges.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (get, list) for all users.
     * @allow (create, update, delete) for none.
     * @deny (create, update, delete) for all users.
     * @principle Allows public read access to challenge templates.
     */
    match /challengeTemplates/{challengeTemplateId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secure user challenges assigned to a specific user. Enforces path-based ownership, restricting access to only the owning user.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (get, create, update, delete, list) if the user is the owner.
     * @deny (get, create, update, delete, list) if the user is not the owner.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
       // Verified user identity
      function isSignedIn() {
        return request.auth != null;
      }

      // Is the user the owner?
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Is the user the existing owner?
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Added due to error report, but rules were not defined.
     * @path /friendRequests
     * @allow (get, list) for all users.
     * @allow (create, update, delete) for none.
     * @deny (create, update, delete) for all users.
     * @principle Allows public read access to friendRequests.
     */
    match /friendRequests/{document} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}