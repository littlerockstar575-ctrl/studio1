/**
 * @fileoverview Firestore Security Rules for GoalForge.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model.  Users can only access their own data
 * stored under their respective user ID. Public read access is granted to challenge templates,
 * while all write access remains protected.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only by the owning user.
 * - /users/{userId}/goals/{goalId}: Goals associated with a user, accessible only by the owning user.
 * - /challengeTemplates/{challengeTemplateId}: Publicly readable challenge templates.  Writes are heavily restricted.
 * - /users/{userId}/userChallenges/{userChallengeId}: User-specific challenges, accessible only by the owning user.
 *
 * Key Security Decisions:
 * - User listing is implicitly denied by the rules structure (no top-level /users collection).
 * - Challenge templates are publicly readable but writes are not yet implemented.
 * - The default security posture is strict: if a relationship isn't explicitly allowed, it's denied.
 *
 * Denormalization for Authorization:
 * This ruleset assumes that all data necessary for authorization is denormalized directly onto the documents.
 * For example, UserChallenges contain a `userId` field that must match the `userId` in the path.
 * This avoids the need for costly `get()` calls in the security rules.
 *
 * Structural Segregation:
 * Private user data (profiles, goals, challenges) is stored under the /users/{userId} path,
 * while public data (challenge templates) is stored in a separate top-level collection.
 * This simplifies security rules and improves performance for list operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects user profiles, allowing only the owner to read and write.
     * @path /users/{userId}
     * @allow (create, update, delete) if request.auth.uid == userId
     * @allow (get, list) if request.auth.uid == userId
     * @deny (create, update, delete) if request.auth.uid != userId
     * @deny (get, list) if request.auth.uid != userId
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if isOwner(userId);
      allow create: if isSignedIn() && request.auth.uid == userId && request.resource.data.id == request.auth.uid;
      allow update: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow delete: if isOwner(userId);
    }

    /**
     * @description Protects goals associated with a specific user. Only the owning user can access their goals.
     * @path /users/{userId}/goals/{goalId}
     * @allow (create, update, delete) if request.auth.uid == userId
     * @allow (get, list) if request.auth.uid == userId
     * @deny (create, update, delete) if request.auth.uid != userId
     * @deny (get, list) if request.auth.uid != userId
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/goals/{goalId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(userId);
    }

    /**
     * @description Defines access rules for challenge templates. Public read, restricted writes.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow get, list: if true;
     * @deny create, update, delete: if false; // TODO: Add admin validation if write access is needed.
     * @principle Allows public read access to challenge templates.
     */
    match /challengeTemplates/{challengeTemplateId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add admin validation if write access is needed.
    }

    /**
     * @description Protects user challenges assigned to a specific user. Only the owning user can access their challenges.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (create, update, delete) if request.auth.uid == userId
     * @allow (get, list) if request.auth.uid == userId
     * @deny (create, update, delete) if request.auth.uid != userId
     * @deny (get, list) if request.auth.uid != userId
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(userId);
    }

    /**
     * @description Restricts access to the friendRequests collection. Only the owner can list.
     * @path /friendRequests
     * @allow list: if false;
     * @deny get, create, update, delete: if true;
     * @principle Enforces that friendRequests collection should not be accessible.
     */
    match /friendRequests/{document} {
        allow get, create, update, delete: if false;
        allow list: if false;
    }
  }
}