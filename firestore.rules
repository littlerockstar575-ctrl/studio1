/**
 * @fileoverview Firestore Security Rules for GoalForge.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model.  Users can only access their own data, with the exception of public challenge templates.
 *
 * Data Structure:
 * - /users/{userId}:  User profile data. Only the authenticated user can read/write their profile.
 * - /users/{userId}/goals/{goalId}: Goals associated with a specific user. Only the owning user can access these goals.
 * - /challengeTemplates/{challengeTemplateId}: Public challenge templates. Accessible by all users.
 * - /users/{userId}/userChallenges/{userChallengeId}: User-specific challenges. Only the owning user can access these.
 * - /friendRequests: List operation was denied.
 *
 * Key Security Decisions:
 * - User listing is implicitly disallowed (no top-level `/users` collection).
 * - Challenge Templates are globally readable.
 *
 * Denormalization for Authorization:
 * - Ownership is enforced via path-based rules, eliminating the need for `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own profile data.
     * @path /users/{userId}
     * @allow (create, update, get, delete) if request.auth.uid == userId
     * @deny (create, update, get, delete) if request.auth.uid != userId
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      // Only signed-in users can access user documents
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false; // Listing users is not permitted.
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Allows users to manage their own goals.
     * @path /users/{userId}/goals/{goalId}
     * @allow (create, update, get, delete) if request.auth.uid == userId
     * @deny (create, update, get, delete) if request.auth.uid != userId
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/goals/{goalId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Allows anyone to read challenge templates, but restricts creation, update, and deletion.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow get, list: if true
     * @deny create, update, delete: if false
     * @principle Challenge templates are publically readable but not writeable.
     */
    match /challengeTemplates/{challengeTemplateId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows users to manage their own user challenges.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (create, update, get, delete) if request.auth.uid == userId
     * @deny (create, update, get, delete) if request.auth.uid != userId
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // Error reported due to the following:
    match /friendRequests {
        allow list: if false;
        allow get: if false;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }

  }
}