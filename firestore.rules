/**
 * @file Firestore Security Rules for GoalForge
 * @version Prototyping Mode - Authorization Focused
 *
 * @description
 * This ruleset enforces a strict user-ownership model for personal data
 * while allowing public read access to challenge templates. Data shape
 * validation is minimized to enable rapid prototyping.
 *
 * @dataStructure
 * - /users/{userId}: Stores user profiles, accessible only by the user.
 * - /users/{userId}/goals/{goalId}: Stores goals, accessible only by the user.
 * - /challengeTemplates/{challengeTemplateId}: Stores challenge templates, publicly readable.
 * - /users/{userId}/userChallenges/{userChallengeId}: Stores user challenges, accessible only by the user.
 *
 * @keySecurityDecisions
 * - No user listing is allowed to prevent unauthorized data access.
 * - Challenge templates are publicly readable to allow all users to fetch them.
 * - All writes require authentication.
 * - The rules explicitly deny all operations that are not explicitly allowed.
 *
 * @denormalizationForAuthorization
 *   The data model copies the userId into subcollection documents (Goal, UserChallenge)
 *   to avoid the need for expensive `get()` calls in security rules. This ensures
 *   efficient and scalable authorization checks.
 *
 * @structuralSegregation
 *   Private user data is stored in user-specific subcollections (/users/{userId}/...).
 *   Public challenge templates are stored in a top-level collection (/challengeTemplates/{challengeTemplateId}).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces access control for user profiles.
     * @path /users/{userId}
     * @allow (create) - Authenticated user can create their own profile if the userId matches their auth UID.
     * @allow (get, update, delete) - Authenticated user can read, update, or delete their own profile.
     * @deny (create) - An unauthenticated user cannot create a profile.
     * @deny (get, update, delete) - An authenticated user cannot read, update, or delete another user's profile.
     * @deny (list) - User listing is disallowed.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      //Disallow listing all users
      allow list: if false;

      // Users can only create their own profile, and the userId must match the authenticated user's UID.
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;

      // Users can read their own profile.
      allow get: if isOwner(userId);

      // Users can update their own profile.  The ID field must be immutable.
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;

      // Users can delete their own profile.
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces access control for goals within a user's profile.
     * @path /users/{userId}/goals/{goalId}
     * @allow (create) - Authenticated user can create a goal within their own profile.
     * @allow (get, update, delete) - Authenticated user can read, update, or delete a goal within their own profile.
     * @deny (create) - An unauthenticated user cannot create a goal.
     * @deny (get, update, delete) - An authenticated user cannot read, update, or delete a goal within another user's profile.
     * @deny (list) - Listing goals is only allowed for the owning user.
     * @principle Enforces document ownership for all operations within a user's data tree.
     */
    match /users/{userId}/goals/{goalId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      // Only the owner can list their goals.
      allow list: if isOwner(userId);

      // Users can create goals under their own user id.
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;

      // Users can read their own goals.
      allow get: if isOwner(userId);

      // Users can update their own goals
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;

      // Users can delete their own goals.
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to challenge templates.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (get, list) - Any user can read the challenge templates.
     * @deny (create, update, delete) - No user can create, update, or delete a challenge template.
     * @principle Allows public read access while restricting write access.
     */
    match /challengeTemplates/{challengeTemplateId} {
      // Challenge templates are publicly readable.
      allow get, list: if true;

      // No one can create challenge templates through the client.
      allow create: if false;

      // No one can update challenge templates through the client.
      allow update: if false;

      // No one can delete challenge templates through the client.
      allow delete: if false;
    }

    /**
     * @description Enforces access control for user challenges within a user's profile.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (create) - Authenticated user can create a challenge within their own profile.
     * @allow (get, update, delete) - Authenticated user can read, update, or delete a challenge within their own profile.
     * @deny (create) - An unauthenticated user cannot create a challenge.
     * @deny (get, update, delete) - An authenticated user cannot read, update, or delete a challenge within another user's profile.
     * @deny (list) - Listing challenges is only allowed for the owning user.
     * @principle Enforces document ownership for all operations within a user's data tree.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      // Only the owner can list their userChallenges.
      allow list: if isOwner(userId);

      // Users can create challenges under their own user id.
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;

      // Users can read their own challenges.
      allow get: if isOwner(userId);

      // Users can update their own challenges.
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;

      // Users can delete their own challenges.
      allow delete: if isExistingOwner(userId);
    }
  }
}