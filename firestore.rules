/**
 * @file Firebase Security Rules for GoalForge Application
 *
 * @core_philosophy This ruleset enforces a strict user-ownership model. Users can only access and modify data associated with their own user ID.
 *
 * @data_structure Data is organized hierarchically under the /users/{userId} collection. Each user has their own profile, goals, challenges, and friend requests stored as subcollections.
 *
 * @key_security_decisions
 *   - Users can only create, read, update, and delete their own user documents and associated data.
 *   - Listing of all users is disallowed.
 *   - Challenge templates are publicly readable.
 *   - The friend request collection lives as a subcollection of `/users/{userId}/friendRequests`
 *   - All write operations require a verified user identity (`request.auth != null`).
 *
 * @denormalization_for_authorization
 *   - User documents MUST contain an `id` field that matches the `userId` in the path. This is enforced on creation and update.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by a signed-in user.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the existing document.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (create) - A user can create their own user document if the userId matches their auth UID.
     * @allow (get, update, delete) - A user can read, update, and delete their own user document.
     * @deny (create) - A user cannot create a user document for another user.
     * @deny (get, update, delete) - A user cannot read, update, or delete another user's document.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for the /users/{userId}/goals/{goalId} collection.
     * @path /users/{userId}/goals/{goalId}
     * @allow (create, get, update, delete, list) - A user can manage their own goals.
     * @deny (create, get, update, delete, list) - A user cannot manage another user's goals.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/goals/{goalId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for the /challengeTemplates/{challengeTemplateId} collection.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (get, list) - All users can read challenge templates.
     * @deny (create, update, delete) - No user can create, update, or delete challenge templates.
     * @principle Challenge templates are publicly readable, but not writable.
     */
    match /challengeTemplates/{challengeTemplateId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Rules for the /users/{userId}/userChallenges/{userChallengeId} collection.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (create, get, update, delete, list) - A user can manage their own user challenges.
     * @deny (create, get, update, delete, list) - A user cannot manage another user's challenges.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for the /users/{userId}/friendRequests/{requestId} collection.
     * @path /users/{userId}/friendRequests/{requestId}
     * @allow (create, get, update, delete, list) - A user can manage their own friend requests.
     * @deny (create, get, update, delete, list) - A user cannot manage another user's friend requests.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/friendRequests/{requestId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.receiverId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.receiverId == userId;
      allow delete: if isExistingOwner(userId);
    }
  }
}