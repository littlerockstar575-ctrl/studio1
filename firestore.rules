/**
 * @fileoverview Firestore Security Rules for GoalForge.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model.  Users can only access their own data, with the exception of public challenge templates.
 *
 * Data Structure:
 * - /users/{userId}:  User profile data. Only the authenticated user can read/write their profile.
 * - /users/{userId}/goals/{goalId}: Goals associated with a specific user. Only the owning user can access these goals.
 * - /challengeTemplates/{challengeTemplateId}: Public challenge templates. Accessible by all users for reading. Write access is denied.
 * - /users/{userId}/userChallenges/{userChallengeId}: User-specific challenges. Only the owning user can access these challenges.
 * - /friendRequests: Collection for storing friend requests. **PUBLIC READ, OWNER WRITE**
 *
 * Key Security Decisions:
 * - No user listing: Listing all users is disallowed for privacy.
 * - Challenge templates are publicly readable but not writable.
 * - Subcollections are secured based on the parent user ID, enforcing strong ownership.
 *
 * Denormalization for Authorization:
 * - The data structure is designed to avoid `get()` calls in security rules by nesting data under user-specific paths, enabling atomic operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     * @return {boolean} True if the request is authenticated, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the request is made by the owner of the resource.
     * @param {string} userId The user ID to compare with the request's authentication UID.
     * @return {boolean} True if the request is made by the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the request is made by the existing owner of the resource, ensuring the resource exists.
     * @param {string} userId The user ID to compare with the resource's owner ID.
     * @return {boolean} True if the request is made by the existing owner, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) User with matching UID can create their profile.
     * @allow (get, update, delete) Authenticated user can access their own profile.
     * @deny (create) User attempts to create a profile with a mismatched UID.
     * @deny (get, update, delete) Unauthorized user attempts to access another user's profile.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for goals associated with a specific user.
     * @path /users/{userId}/goals/{goalId}
     * @allow (create) Authenticated user can create a goal under their profile.
     * @allow (get, update, delete) Authenticated user can access their own goals.
     * @deny (create) User attempts to create a goal with a mismatched UID.
     * @deny (get, update, delete) Unauthorized user attempts to access another user's goals.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId}/goals/{goalId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for challenge templates.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (get, list) All users can read challenge templates.
     * @deny (create, update, delete) No users can create, update or delete challenge templates.
     * @principle Allows public read access for challenge templates while restricting write access.
     */
    match /challengeTemplates/{challengeTemplateId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Rules for user challenges assigned to a specific user.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (create) Authenticated user can create a user challenge under their profile.
     * @allow (get, update, delete) Authenticated user can access their own user challenges.
     * @deny (create) User attempts to create a user challenge with a mismatched UID.
     * @deny (get, update, delete) Unauthorized user attempts to access another user's user challenges.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

     /**
      * @description Rules for friend requests. Allows public read and owner-only writes.
      * @path /friendRequests
      * @allow (get, list) All users can read friend requests.
      * @allow (create, update, delete) No users can create, update or delete friend requests.
      * @principle Allows public read access for friend requests while restricting write access.
      */
    match /friendRequests {
        allow get, list: if true;
        allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }
  }
}