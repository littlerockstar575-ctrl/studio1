/**
 * @file Firestore Security Rules
 * @core_philosophy This ruleset prioritizes public read access with owner-only write access for rapid prototyping.
 * It leverages path-based authorization and helper functions to enforce security principles.
 * @data_structure Data is organized into user-centric subcollections under `/users/{userId}` for private data,
 * and top-level collections like `/challengeTemplates` for public data.
 * @key_security_decisions Public read access is granted to `/challengeTemplates`.
 * All write operations require authentication and owner validation.
 * `friendRequests` are managed in user subcollections, ensuring that users can only manage their own incoming requests.
 * @denormalization Authorization relies on the `request.auth.uid` and direct comparison with document fields to avoid costly `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profiles. Only the authenticated user can read/write their own profile.
     * @path /users/{userId}
     * @allow (create) - Authenticated user with matching UID creates their profile.
     * @allow (get, list) - Any user can read the data.
     * @allow (update) - Authenticated user with matching UID updates their profile.
     * @allow (delete) - Authenticated user with matching UID deletes their profile.
     * @deny (create) - User attempts to create a profile with a mismatched UID.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Manages goals associated with a specific user. Only the owning user can access these goals.
     * @path /users/{userId}/goals/{goalId}
     * @allow (create) - Authenticated user with matching UID creates a goal.
     * @allow (get, list) - Any user can read the data.
     * @allow (update) - Authenticated user with matching UID updates their goal.
     * @allow (delete) - Authenticated user with matching UID deletes their goal.
     * @deny (create) - User attempts to create a goal with a mismatched UID.
     * @principle Enforces document ownership for writes within a user-specific subcollection.
     */
    match /users/{userId}/goals/{goalId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Manages challenge templates. Accessible by all users.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (get, list) - Any user can read the data.
     * @allow (create) - No one can create data.
     * @allow (update) - No one can update data.
     * @allow (delete) - No one can delete data.
     * @principle Provides public read access to challenge templates.
     */
    match /challengeTemplates/{challengeTemplateId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages user challenges assigned to a specific user. Enforces path-based ownership.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (create) - Authenticated user with matching UID creates a challenge.
     * @allow (get, list) - Any user can read the data.
     * @allow (update) - Authenticated user with matching UID updates their challenge.
     * @allow (delete) - Authenticated user with matching UID deletes their challenge.
     * @deny (create) - User attempts to create a challenge with a mismatched UID.
     * @principle Enforces document ownership for writes within a user-specific subcollection.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

     /**
      * @description Stores friend requests sent to a user in a subcollection. Security rules enforce that users can only manage requests sent to them.
      * @path /users/{userId}/friendRequests/{requestId}
      * @allow (create) - Authenticated user can create a friend request for the user in the path.
      * @allow (get, list) - Any user can read the data.
      * @allow (update) - Authenticated user can update the status of a friend request if they are the receiver.
      * @allow (delete) - Authenticated user can delete a friend request if they are the receiver.
      * @deny (create) - User attempts to create a friend request for a different user by changing the path.
      */
    match /users/{userId}/friendRequests/{requestId} {
        function isOwner(userId) {
            return request.auth != null && request.auth.uid == userId;
        }
        function isSignedIn() {
            return request.auth != null;
        }

        allow get, list: if true;
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
    }
  }
}