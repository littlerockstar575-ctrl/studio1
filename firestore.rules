/**
 * @fileoverview Firestore Security Rules for GoalForge.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles, goals, and user challenges.
 * Challenge templates are publicly readable.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only by the owning user.
 * - /users/{userId}/goals/{goalId}: Goals associated with a user, accessible only by the owning user.
 * - /challengeTemplates/{challengeTemplateId}: Publicly readable challenge templates.
 * - /users/{userId}/userChallenges/{userChallengeId}: User-specific challenges, accessible only by the owning user.
 *
 * Key Security Decisions:
 * - Users can only access their own profiles and associated data (goals, challenges).
 * - Challenge templates are publicly readable to allow all users to fetch and use them.
 * - No user listing is allowed to prevent information disclosure.
 *
 * Denormalization for Authorization:
 * The data structure leverages path-based authorization, eliminating the need for `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user123' can create their profile at /users/user123 if request.auth.uid == 'user123'.
     * @allow (get) - User with UID 'user123' can read their profile at /users/user123 if request.auth.uid == 'user123'.
     * @allow (update) - User with UID 'user123' can update their profile at /users/user123 if request.auth.uid == 'user123'.
     * @allow (delete) - User with UID 'user123' can delete their profile at /users/user123 if request.auth.uid == 'user123'.
     * @deny (create) - User with UID 'user456' cannot create a profile at /users/user123.
     * @deny (get) - User with UID 'user456' cannot read the profile at /users/user123.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to goals associated with a user.
     * @path /users/{userId}/goals/{goalId}
     * @allow (create) - User with UID 'user123' can create a goal at /users/user123/goals/goal456 if request.auth.uid == 'user123'.
     * @allow (get) - User with UID 'user123' can read the goal at /users/user123/goals/goal456 if request.auth.uid == 'user123'.
     * @allow (update) - User with UID 'user123' can update the goal at /users/user123/goals/goal456 if request.auth.uid == 'user123'.
     * @allow (delete) - User with UID 'user123' can delete the goal at /users/user123/goals/goal456 if request.auth.uid == 'user123'.
     * @deny (create) - User with UID 'user456' cannot create a goal at /users/user123/goals/goal456.
     * @deny (get) - User with UID 'user456' cannot read the goal at /users/user123/goals/goal456.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/goals/{goalId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to challenge templates.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (get) - Any user can read a challenge template.
     * @allow (list) - Any user can list challenge templates.
     * @deny (create) - No one can create challenge templates through the client.
     * @deny (update) - No one can update challenge templates through the client.
     * @deny (delete) - No one can delete challenge templates through the client.
     * @principle Challenge templates are globally accessible for reading.
     */
    match /challengeTemplates/{challengeTemplateId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to user challenges assigned to a specific user.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (create) - User with UID 'user123' can create a challenge at /users/user123/userChallenges/challenge456 if request.auth.uid == 'user123'.
     * @allow (get) - User with UID 'user123' can read the challenge at /users/user123/userChallenges/challenge456 if request.auth.uid == 'user123'.
     * @allow (update) - User with UID 'user123' can update the challenge at /users/user123/userChallenges/challenge456 if request.auth.uid == 'user123'.
     * @allow (delete) - User with UID 'user123' can delete the challenge at /users/user123/userChallenges/challenge456 if request.auth.uid == 'user123'.
     * @deny (create) - User with UID 'user456' cannot create a challenge at /users/user123/userChallenges/challenge456.
     * @deny (get) - User with UID 'user456' cannot read the challenge at /users/user123/userChallenges/challenge456.
     * @principle Enforces path-based ownership, restricting access to only the owning user.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
    
    /**
     * @description This is a catch-all for any other paths in the database that haven't been explicitly secured.
     * @path Any other path not explicitly matched.
     * @deny (get, list, create, update, delete) - All access is denied to these paths.
     * @principle Ensures that any non explicitly defined paths are completely locked down.
     */
    match /{path=**} {
        allow get: if false;
        allow list: if false;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }
  }
}