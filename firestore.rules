/**
 * @fileoverview Firestore Security Rules for GoalForge.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model, augmented by public read access where appropriate.  Data is organized to minimize the need for complex queries within the rules.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only by the owning user.
 * - /users/{userId}/goals/{goalId}: User's goals, accessible only by the owning user.
 * - /challengeTemplates/{challengeTemplateId}: Publicly accessible challenge templates.
 * - /users/{userId}/userChallenges/{userChallengeId}: User's challenges, accessible only by the owning user.
 * - /friendRequests: List operation blocked for all users.
 *
 * Key Security Decisions:
 * - No user listing is allowed to protect user privacy.
 * - Challenge templates are publicly readable but not writable.
 * - Strict ownership is enforced for user profiles, goals, and user challenges.
 * - friendRequests collection listing is forbidden.
 *
 * Denormalization for Authorization:
 * The data structure is designed such that access control decisions can be made based on the path and data within a document, without requiring additional `get()` calls. For example, the `userId` is embedded within the Goal and UserChallenge documents.
 *
 * Structural Segregation:
 * Publicly readable data (challenge templates) is stored in a separate top-level collection, while private user data is stored under the `/users/{userId}` path.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     * @returns {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource.
     * @param {string} userId - The user ID to compare against the request's auth UID.
     * @returns {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the existing resource.
     * @param {string} userId - The user ID to compare against the resource's userId and the request's auth UID.
     * @returns {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Defines the rules for the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (create) User 'ftB703Oot8aUgKL2RiibrONPaO32' can create their profile.
     * @allow (get) User 'ftB703Oot8aUgKL2RiibrONPaO32' can read their profile.
     * @allow (update) User 'ftB703Oot8aUgKL2RiibrONPaO32' can update their profile.
     * @allow (delete) User 'ftB703Oot8aUgKL2RiibrONPaO32' can delete their profile.
     * @deny (create) User 'randomId' cannot create a profile with ID 'ftB703Oot8aUgKL2RiibrONPaO32'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Defines the rules for the /users/{userId}/goals/{goalId} collection.
     * @path /users/{userId}/goals/{goalId}
     * @allow (create) User 'ftB703Oot8aUgKL2RiibrONPaO32' can create a goal under their profile.
     * @allow (get) User 'ftB703Oot8aUgKL2RiibrONPaO32' can read a goal under their profile.
     * @allow (update) User 'ftB703Oot8aUgKL2RiibrONPaO32' can update a goal under their profile.
     * @allow (delete) User 'ftB703Oot8aUgKL2RiibrONPaO32' can delete a goal under their profile.
     * @deny (create) User 'randomId' cannot create a goal under user 'ftB703Oot8aUgKL2RiibrONPaO32''s profile.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/goals/{goalId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Defines the rules for the /challengeTemplates/{challengeTemplateId} collection.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (get) Any user can read challenge templates.
     * @deny (create) No user can create challenge templates.
     * @deny (update) No user can update challenge templates.
     * @deny (delete) No user can delete challenge templates.
     * @principle Allows public read access for challenge templates and restricts writes.
     */
    match /challengeTemplates/{challengeTemplateId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Defines the rules for the /users/{userId}/userChallenges/{userChallengeId} collection.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (create) User 'ftB703Oot8aUgKL2RiibrONPaO32' can create a user challenge under their profile.
     * @allow (get) User 'ftB703Oot8aUgKL2RiibrONPaO32' can read a user challenge under their profile.
     * @allow (update) User 'ftB703Oot8aUgKL2RiibrONPaO32' can update a user challenge under their profile.
     * @allow (delete) User 'ftB703Oot8aUgKL2RiibrONPaO32' can delete a user challenge under their profile.
     * @deny (create) User 'randomId' cannot create a user challenge under user 'ftB703Oot8aUgKL2RiibrONPaO32''s profile.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Defines the rules for the /friendRequests collection. List access is forbidden
     * @path /friendRequests
     * @deny (list) No user can list the friendRequests collection.
     * @principle Denies list access to the friendRequests collection.
     */
    match /friendRequests {
        allow get: if false;
        allow list: if false;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }
  }
}