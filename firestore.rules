/**
 * @fileoverview Firestore Security Rules for GoalForge.
 *
 * Core Philosophy: This ruleset enforces a strict user-ownership model for personal data,
 * while allowing public read access to challenge templates. Data is segregated to simplify
 * security rules and prevent unauthorized access.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, secured via owner-only access.
 * - /users/{userId}/goals/{goalId}: Stores user-specific goals, secured via owner-only access.
 * - /challengeTemplates/{challengeTemplateId}: Stores public challenge templates, readable by all.
 * - /users/{userId}/userChallenges/{userChallengeId}: Stores user-specific challenges, secured via owner-only access.
 *
 * Key Security Decisions:
 * - User listing is implicitly disallowed.
 * - Challenge templates are publicly readable.
 * - Subcollections are secured based on parent user ID, enforcing strong ownership.
 *
 * Denormalization for Authorization:
 * - The current design relies on path-based ownership, so no additional denormalization is required.
 *   The `userId` parameter in the path directly corresponds to the authenticated user's UID.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces owner-only access to user profiles.
     * @path /users/{userId}
     * @allow (create) User with ID 'user_abc' can create their profile with matching ID.
     * @allow (get) User with ID 'user_abc' can read their own profile.
     * @allow (update) User with ID 'user_abc' can update their own profile.
     * @allow (delete) User with ID 'user_abc' can delete their own profile.
     * @deny (create) User with ID 'user_abc' cannot create a profile with ID 'user_xyz'.
     * @deny (get) User with ID 'user_xyz' cannot read user 'user_abc' profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && resource.data.id == userId;
      allow delete: if isOwner(userId) && resource != null;
    }

    /**
     * @description Enforces owner-only access to user-specific goals.
     * @path /users/{userId}/goals/{goalId}
     * @allow (create) User with ID 'user_abc' can create a goal under their profile.
     * @allow (get) User with ID 'user_abc' can read a goal under their profile.
     * @allow (update) User with ID 'user_abc' can update a goal under their profile.
     * @allow (delete) User with ID 'user_abc' can delete a goal under their profile.
     * @deny (create) User with ID 'user_xyz' cannot create a goal under user 'user_abc'.
     * @deny (get) User with ID 'user_xyz' cannot read a goal under user 'user_abc'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/goals/{goalId} {
        function isOwner(userId) {
          return request.auth != null && request.auth.uid == userId;
        }
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) && resource != null;
        allow delete: if isOwner(userId) && resource != null;
    }

    /**
     * @description Allows public read access to challenge templates.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (get) Any user can read a challenge template.
     * @allow (list) Any user can list challenge templates.
     * @deny (create) No one can create challenge templates through client.
     * @deny (update) No one can update challenge templates through the client.
     * @deny (delete) No one can delete challenge templates through the client.
     * @principle Provides public read access to static challenge templates.
     */
    match /challengeTemplates/{challengeTemplateId} {
        allow get: if true;
        allow list: if true;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }

    /**
     * @description Enforces owner-only access to user-specific challenges.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (create) User with ID 'user_abc' can create a challenge under their profile.
     * @allow (get) User with ID 'user_abc' can read a challenge under their profile.
     * @allow (update) User with ID 'user_abc' can update a challenge under their profile.
     * @allow (delete) User with ID 'user_abc' can delete a challenge under their profile.
     * @deny (create) User with ID 'user_xyz' cannot create a challenge under user 'user_abc'.
     * @deny (get) User with ID 'user_xyz' cannot read a challenge under user 'user_abc'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
        function isOwner(userId) {
          return request.auth != null && request.auth.uid == userId;
        }
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) && resource != null;
        allow delete: if isOwner(userId) && resource != null;
    }
  }
}