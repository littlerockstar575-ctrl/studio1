/**
 * @file Firestore Security Rules
 * @version 2
 *
 * @description This ruleset allows public access to all data.
 *
 * @data_structure
 * - `/users/{userId}`: Stores user profiles.
 * - `/users/{userId}/goals/{goalId}`: Stores goals associated with a specific user.
 * - `/challengeTemplates/{challengeTemplateId}`: Stores challenge templates.
 * - `/users/{userId}/userChallenges/{userChallengeId}`: Stores user challenges assigned to a specific user.
 * - `/users/{userId}/friendRequests/{requestId}`: Stores friend requests sent to a user.
 *
 * @key_security_decisions
 * - All read and write operations are allowed for all users, including unauthenticated users.
 *   This configuration is intended for prototyping and should not be used in a production environment.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows any user to read or write user profiles.
     * @path /users/{userId}
     * @allow (create) - Any user can create a user profile.
     * @allow (get) - Any user can read any user profile.
     * @allow (list) - Any user can list user profiles.
     * @allow (update) - Any user can update any user profile.
     * @allow (delete) - Any user can delete any user profile.
     * @principle Allows public access to all user profiles.
     */
    match /users/{userId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows any user to read or write goals associated with a specific user.
     * @path /users/{userId}/goals/{goalId}
     * @allow (create) - Any user can create a goal for any user.
     * @allow (get) - Any user can read any goal.
     * @allow (list) - Any user can list goals.
     * @allow (update) - Any user can update any goal.
     * @allow (delete) - Any user can delete any goal.
     * @principle Allows public access to all goals.
     */
    match /users/{userId}/goals/{goalId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows any user to read or write challenge templates.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (get) - Any user can read any challenge template.
     * @allow (list) - Any user can list challenge templates.
     * @allow (create) - Any user can create a challenge template.
     * @allow (update) - Any user can update a challenge template.
     * @allow (delete) - Any user can delete a challenge template.
     * @principle Allows public access to all challenge templates.
     */
    match /challengeTemplates/{challengeTemplateId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows any user to read or write user challenges assigned to a specific user.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (create) - Any user can create a user challenge for any user.
     * @allow (get) - Any user can read any user challenge.
     * @allow (list) - Any user can list user challenges.
     * @allow (update) - Any user can update any user challenge.
     * @allow (delete) - Any user can delete any user challenge.
     * @principle Allows public access to all user challenges.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows any user to read or write friend requests.
     * @path /users/{userId}/friendRequests/{requestId}
     * @allow (create) - Any user can create a friend request.
     * @allow (get) - Any user can read any friend request.
     * @allow (list) - Any user can list friend requests.
     * @allow (update) - Any user can update any friend request.
     * @allow (delete) - Any user can delete any friend request.
     * @principle Allows public access to all friend requests.
     */
    match /users/{userId}/friendRequests/{requestId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }
  }
}