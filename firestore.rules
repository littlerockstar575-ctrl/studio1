/**
 * @fileoverview Firestore Security Rules for GoalForge application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model, ensuring that users can only
 * access their own data. Public read access is granted to challenge templates.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles.
 * - /users/{userId}/goals/{goalId}: Stores goals associated with a specific user.
 * - /challengeTemplates/{challengeTemplateId}: Stores challenge templates.
 * - /users/{userId}/userChallenges/{userChallengeId}: Stores user challenges assigned to a specific user.
 * - /users/{userId}/friendRequests/{requestId}: Stores friend requests sent to a user.
 *
 * Key Security Decisions:
 * - Users can only manage friend requests sent to them (ownership).
 * - Challenge templates are publicly readable.
 *
 * Denormalization for Authorization:
 * - The `userId` is denormalized into the `/goals/{goalId}` document to avoid needing to perform expensive `get()` calls to the `/users/{userId}` document to verify ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows access to user profiles, enforcing user ownership.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user_abc' can create their own profile with id 'user_abc'.
     * @allow (get, update, delete) - User with UID 'user_abc' can read, update, and delete their own profile.
     * @deny (create, get, update, delete) - User with UID 'user_xyz' cannot access the profile of user 'user_abc'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Allows access to goals associated with a specific user, enforcing user ownership.
     * @path /users/{userId}/goals/{goalId}
     * @allow (create) - User with UID 'user_abc' can create a goal under their profile.
     * @allow (get, update, delete) - User with UID 'user_abc' can read, update, and delete their own goal.
     * @deny (create, get, update, delete) - User with UID 'user_xyz' cannot access goals of user 'user_abc'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/goals/{goalId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to challenge templates.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (get, list) - Any user (signed in or not) can read challenge templates.
     * @deny (create, update, delete) - No one can create, update, or delete challenge templates.
     * @principle Allows public read access while restricting write access.
     */
    match /challengeTemplates/{challengeTemplateId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows access to user challenges assigned to a specific user, enforcing user ownership.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (create) - User with UID 'user_abc' can create a user challenge under their profile.
     * @allow (get, update, delete) - User with UID 'user_abc' can read, update, and delete their own user challenge.
     * @deny (create, get, update, delete) - User with UID 'user_xyz' cannot access user challenges of user 'user_abc'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Allows access to friend requests sent to a user, enforcing user ownership.
     * @path /users/{userId}/friendRequests/{requestId}
     * @allow (create) - User with UID 'user_abc' can create a friend request sent to them under their profile.
     * @allow (get, update, delete) - User with UID 'user_abc' can read, update, and delete friend requests sent to them.
     * @deny (create, get, update, delete) - User with UID 'user_xyz' cannot access friend requests of user 'user_abc'.
     * @principle Enforces document ownership for writes.
     */
     match /users/{userId}/friendRequests/{requestId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isOwner(userId) {
          return request.auth.uid == userId;
        }

        function isExistingOwner(userId) {
          return isOwner(userId) && resource.data != null;
        }

        allow get: if isSignedIn() && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && request.resource.data.receiverId == userId && request.auth.uid == request.resource.data.senderId;
        allow update: if isSignedIn() && isExistingOwner(userId);
        allow delete: if isSignedIn() && isExistingOwner(userId);
    }
  }
}