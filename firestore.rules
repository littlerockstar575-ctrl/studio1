/**
 * @fileoverview Firestore Security Rules for GoalForge.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model, ensuring that users can only access and modify their own data.
 * Friend Request data is stored in subcollections under each user's document.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only to the owning user.
 * - /users/{userId}/goals/{goalId}: Goals associated with a specific user, accessible only to the owning user.
 * - /challengeTemplates/{challengeTemplateId}: Challenge templates, publicly readable.
 * - /users/{userId}/userChallenges/{userChallengeId}: User-specific challenges, accessible only to the owning user.
 * - /users/{userId}/friendRequests/{requestId}: Friend requests sent to a user, accessible only to the recipient.
 *
 * Key Security Decisions:
 * - Users can only create, read, update, and delete their own user documents and associated subcollections (goals, userChallenges, friendRequests).
 * - Listing of user documents is disallowed.
 * - Challenge templates are publicly readable but not writable.
 * - Friend Request are now managed as subcollections under each user for improved security and scalability.
 *
 * Denormalization for Authorization:
 * - The rules rely on path-based authorization and the `request.auth.uid` to determine ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure the /users/{userId} collection to only allow access to the authenticated user.
     * @path /users/{userId}
     * @allow (create) - Authenticated user with UID 'user123' can create their own user document.
     * @deny (create) - Authenticated user with UID 'user123' cannot create a user document with a different UID 'user456'.
     * @allow (get, update, delete) - Authenticated user with UID 'user123' can read, update, and delete their own user document.
     * @deny (get, update, delete) - Authenticated user with UID 'user123' cannot read, update, and delete another user's document with UID 'user456'.
     * @deny (list) - No one can list user documents.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow get: if isOwner(userId);
      allow list: if false;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure the /users/{userId}/goals/{goalId} collection to only allow access to the owning user.
     * @path /users/{userId}/goals/{goalId}
     * @allow (create) - Authenticated user with UID 'user123' can create a goal under their user document.
     * @deny (create) - Authenticated user with UID 'user123' cannot create a goal under another user's document with UID 'user456'.
     * @allow (get, list, update, delete) - Authenticated user with UID 'user123' can read, list, update, and delete goals under their user document.
     * @deny (get, list, update, delete) - Authenticated user with UID 'user123' cannot read, list, update, and delete goals under another user's document with UID 'user456'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/goals/{goalId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow get, list: if isOwner(userId);
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure the /challengeTemplates/{challengeTemplateId} collection to allow public read access.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (get, list) - Any user can read challenge templates.
     * @deny (create, update, delete) - No one can create, update, or delete challenge templates.
     * @principle Provides public read access with restricted write access.
     */
    match /challengeTemplates/{challengeTemplateId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Secure the /users/{userId}/userChallenges/{userChallengeId} collection to only allow access to the owning user.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (create) - Authenticated user with UID 'user123' can create a user challenge under their user document.
     * @deny (create) - Authenticated user with UID 'user123' cannot create a user challenge under another user's document with UID 'user456'.
     * @allow (get, list, update, delete) - Authenticated user with UID 'user123' can read, list, update, and delete user challenges under their user document.
     * @deny (get, list, update, delete) - Authenticated user with UID 'user123' cannot read, list, update, and delete user challenges under another user's document with UID 'user456'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow get, list: if isOwner(userId);
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

     /**
     * @description Secure the /users/{userId}/friendRequests/{requestId} collection to only allow access to the owning user.
     * @path /users/{userId}/friendRequests/{requestId}
     * @allow (create) - Authenticated user with UID 'senderId' can create a friend request under the receiver's user document, only if the `receiverId` matches the document `userId` (the recipient).
     * @deny (create) - Authenticated user with UID 'user123' cannot create a friend request under another user's document with UID 'user456' if not matching the receiver's ID.
     * @allow (get, list, update, delete) - Authenticated user with UID 'userId' can read, list, update, and delete friend requests under their user document.
     * @deny (get, list, update, delete) - Authenticated user with UID 'user123' cannot read, list, update, and delete friend requests under another user's document with UID 'user456'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/friendRequests/{requestId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

        function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow create: if isSignedIn() && request.resource.data.receiverId == userId && request.auth.uid == request.resource.data.senderId;
      allow get, list: if isOwner(userId);
      allow update: if isExistingOwner(userId) && isOwner(userId);
      allow delete: if isExistingOwner(userId) && isOwner(userId);
    }
  }
}