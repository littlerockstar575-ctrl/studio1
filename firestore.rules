/**
 * @file Firestore Security Rules for GoalForge
 *
 * @core_philosophy This ruleset enforces a strict user-ownership model for user-specific data,
 * ensuring that only authenticated users can access their own profiles, goals, and challenges.
 * Public read access is granted to challenge templates. Authorization decisions are based on the
 * authenticated user's UID and path-based ownership.
 *
 * @data_structure
 * - `/users/{userId}`: Stores user profiles, secured by user ID.
 * - `/users/{userId}/goals/{goalId}`: Stores user goals, secured by user ID.
 * - `/challengeTemplates/{challengeTemplateId}`: Stores public challenge templates.
 * - `/users/{userId}/userChallenges/{userChallengeId}`: Stores user challenges, secured by user ID.
 *
 * @key_security_decisions
 * - User data is strictly private and only accessible to the owning user.
 * - Challenge templates are publicly readable but not writable.
 * - The rules explicitly deny any listing of the top-level `friendRequests` collection by any user.
 *
 * @denormalization_for_authorization Not applicable, using path-based ownership.
 * @structural_segregation User-specific data is stored in subcollections under `/users/{userId}`
 * to enforce ownership and prevent unauthorized access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by the owner of the resource.
     * @param {string} userId The user ID to compare against the request's auth UID.
     * @return {bool} True if the request is made by the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is an existing owner of the resource.
     * @param {string} userId The user ID to compare against the resource's owner ID.
     * @return {bool} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) Signed-in user with UID 'user123' can create a profile at /users/user123.
     * @allow (get, update, delete) Signed-in user with UID 'user123' can read/write their profile at /users/user123.
     * @deny (create) Signed-in user with UID 'user456' cannot create a profile at /users/user123.
     * @deny (get, update, delete) Signed-in user with UID 'user456' cannot read/write the profile at /users/user123.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Listing all users is not permitted.
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for user goals.
     * @path /users/{userId}/goals/{goalId}
     * @allow (create) Signed-in user with UID 'user123' can create a goal at /users/user123/goals/goal456.
     * @allow (get, update, delete) Signed-in user with UID 'user123' can read/write their goal at /users/user123/goals/goal456.
     * @deny (create) Signed-in user with UID 'user456' cannot create a goal at /users/user123/goals/goal456.
     * @deny (get, update, delete) Signed-in user with UID 'user456' cannot read/write the goal at /users/user123/goals/goal456.
     * @principle Restricts access to a user's own goals.
     */
    match /users/{userId}/goals/{goalId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for challenge templates.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (get, list) Any user can read challenge templates.
     * @deny (create, update, delete) No user can create, update, or delete challenge templates.
     * @principle Challenge templates are publicly readable and immutable.
     */
    match /challengeTemplates/{challengeTemplateId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Rules for user challenges.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (create) Signed-in user with UID 'user123' can create a challenge at /users/user123/userChallenges/challenge456.
     * @allow (get, update, delete) Signed-in user with UID 'user123' can read/write their challenge at /users/user123/userChallenges/challenge456.
     * @deny (create) Signed-in user with UID 'user456' cannot create a challenge at /users/user123/userChallenges/challenge456.
     * @deny (get, update, delete) Signed-in user with UID 'user456' cannot read/write the challenge at /users/user123/userChallenges/challenge456.
     * @principle Restricts access to a user's own challenges.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for friendRequests collection.
     * @path /friendRequests
     * @deny (list) Listing of the top-level collection is not permitted for any user.
     */
    match /friendRequests/{friendRequest} {
        allow get, create, update, delete: if false;
        allow list: if false;
    }
  }
}