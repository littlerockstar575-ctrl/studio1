/**
 * @file Firestore Security Rules for GoalForge application.
 *
 * @core_philosophy This ruleset enforces a strict user-ownership model for user profiles, goals, and user challenges.
 *  Challenge templates are publicly readable. Friend requests are managed within user-specific subcollections.
 * @data_structure
 *  - /users/{userId}: User profiles, accessible only by the user.
 *  - /users/{userId}/goals/{goalId}: Goals, accessible only by the user.
 *  - /challengeTemplates/{challengeTemplateId}: Challenge templates, publicly readable.
 *  - /users/{userId}/userChallenges/{userChallengeId}: User challenges, accessible only by the user.
 *  - /users/{userId}/friendRequests/{requestId}: Friend requests, accessible only by the receiving user.
 * @key_security_decisions
 *  - Users can only access their own data.
 *  - Challenge templates are publicly readable.
 *  - Listing of friend requests is restricted to the receiving user.
 * @denormalization_for_authorization N/A (Path-based ownership is used)
 * @structural_segregation N/A
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles, allowing only the user to read and write their own profile.
     * @path /users/{userId}
     * @allow (create) User with UID 'user_abc' can create their profile at /users/user_abc.
     * @allow (get) User with UID 'user_abc' can read their profile at /users/user_abc.
     * @allow (update) User with UID 'user_abc' can update their profile at /users/user_abc.
     * @allow (delete) User with UID 'user_abc' can delete their profile at /users/user_abc.
     * @deny (create) User with UID 'user_xyz' cannot create a profile at /users/user_abc.
     * @deny (get) User with UID 'user_xyz' cannot read the profile at /users/user_abc.
     * @principle Enforces document ownership for all operations on user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Secure user goals, allowing only the user to read and write their own goals.
     * @path /users/{userId}/goals/{goalId}
     * @allow (create) User with UID 'user_abc' can create a goal at /users/user_abc/goals/goal_123.
     * @allow (get) User with UID 'user_abc' can read their goal at /users/user_abc/goals/goal_123.
     * @allow (update) User with UID 'user_abc' can update their goal at /users/user_abc/goals/goal_123.
     * @allow (delete) User with UID 'user_abc' can delete their goal at /users/user_abc/goals/goal_123.
     * @deny (create) User with UID 'user_xyz' cannot create a goal at /users/user_abc/goals/goal_123.
     * @deny (get) User with UID 'user_xyz' cannot read the goal at /users/user_abc/goals/goal_123.
     * @principle Enforces document ownership for all operations on user goals.
     */
    match /users/{userId}/goals/{goalId} {
        function isOwner(userId) {
            return request.auth != null && request.auth.uid == userId;
        }
        function isSignedIn() {
          return request.auth != null;
        }
        allow get: if isOwner(userId);
        allow list: if false;
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
    }

    /**
     * @description Allow public read access to challenge templates.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (get) Any user can read a challenge template at /challengeTemplates/template_123.
     * @allow (list) Any user can list challenge templates at /challengeTemplates.
     * @deny (create) No user can create a challenge template.
     * @principle Allows public read access while restricting write access.
     */
    match /challengeTemplates/{challengeTemplateId} {
        allow get: if true;
        allow list: if true;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }

    /**
     * @description Secure user challenges, allowing only the user to read and write their own challenges.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (create) User with UID 'user_abc' can create a challenge at /users/user_abc/userChallenges/challenge_123.
     * @allow (get) User with UID 'user_abc' can read their challenge at /users/user_abc/userChallenges/challenge_123.
     * @allow (update) User with UID 'user_abc' can update their challenge at /users/user_abc/userChallenges/challenge_123.
     * @allow (delete) User with UID 'user_abc' can delete their challenge at /users/user_abc/userChallenges/challenge_123.
     * @deny (create) User with UID 'user_xyz' cannot create a challenge at /users/user_abc/userChallenges/challenge_123.
     * @deny (get) User with UID 'user_xyz' cannot read the challenge at /users/user_abc/userChallenges/challenge_123.
     * @principle Enforces document ownership for all operations on user challenges.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
        function isOwner(userId) {
            return request.auth != null && request.auth.uid == userId;
        }
        function isSignedIn() {
          return request.auth != null;
        }
        allow get: if isOwner(userId);
        allow list: if false;
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
    }

    /**
     * @description Secure friend requests, allowing only the receiving user to manage requests sent to them.
     * @path /users/{userId}/friendRequests/{requestId}
     * @allow (create) User with UID 'user_abc' can create a friend request at /users/user_abc/friendRequests/request_123 if receiverId == user_abc.
     * @allow (get) User with UID 'user_abc' can get a friend request at /users/user_abc/friendRequests/request_123.
     * @allow (update) User with UID 'user_abc' can update a friend request at /users/user_abc/friendRequests/request_123.
     * @allow (delete) User with UID 'user_abc' can delete a friend request at /users/user_abc/friendRequests/request_123.
     * @deny (create) User with UID 'user_xyz' cannot create a friend request at /users/user_abc/friendRequests/request_123.
     * @deny (get) User with UID 'user_xyz' cannot read the friend request at /users/user_abc/friendRequests/request_123.
     * @principle Enforces document ownership for all operations on friend requests.
     */
    match /users/{userId}/friendRequests/{requestId} {
       function isOwner(userId) {
            return request.auth != null && request.auth.uid == userId;
        }
        function isSignedIn() {
          return request.auth != null;
        }
        allow get: if isOwner(userId);
        allow list: if false;
        allow create: if isSignedIn() && request.resource.data.receiverId == userId;
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
    }
  }
}