/**
 * @fileoverview Firestore Security Rules for GoalForge.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for most data, ensuring users can only
 * access their own data. Public read access is granted to challenge templates,
 * while writes are restricted.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, owned by the user.
 * - /users/{userId}/goals/{goalId}: Goals for a specific user, owned by the user.
 * - /challengeTemplates/{challengeTemplateId}: Publicly readable challenge templates.
 * - /users/{userId}/userChallenges/{userChallengeId}: User-specific challenges.
 * - /users/{userId}/friendRequests/{requestId}: Friend requests sent to a user, managed by that user.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Challenge templates are publicly readable but not writable except by backend.
 * - Friend requests are managed within the user's subcollection.
 *
 * Denormalization for Authorization:
 *  - The `userId` is used in the path for subcollections, and the `userId` inside documents is validated for consistency.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to manage their own profiles.
     * @path /users/{userId}
     * @allow (create) User with matching auth UID can create their profile.
     * @allow (get, update, delete) Authenticated user can access their profile.
     * @deny (create) User cannot create a profile with a mismatched UID.
     * @deny (get, update, delete) User cannot access another user's profile.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) ;
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Allows a user to manage their own goals.
     * @path /users/{userId}/goals/{goalId}
     * @allow (create) User can create goals under their own user ID.
     * @allow (get, update, delete) User can access goals under their own user ID.
     * @deny (create) User cannot create goals under another user's ID.
     * @deny (get, update, delete) User cannot access goals under another user's ID.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/goals/{goalId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Allows anyone to read challenge templates, but restricts creation, updates, and deletion.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (get, list) Any user can read challenge templates.
     * @deny (create, update, delete) Only backend services should create, update, or delete challenge templates.
     * @principle Provides public read access while restricting write access.
     */
    match /challengeTemplates/{challengeTemplateId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows a user to manage their own challenges.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (create) User can create challenges under their own user ID.
     * @allow (get, update, delete) User can access challenges under their own user ID.
     * @deny (create) User cannot create challenges under another user's ID.
     * @deny (get, update, delete) User cannot access challenges under another user's ID.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Allows a user to manage friend requests sent to them.
     * @path /users/{userId}/friendRequests/{requestId}
     * @allow (create) User can create friend requests under their own user ID.
     * @allow (get, update, delete) User can access friend requests under their own user ID.
     * @deny (create) User cannot create friend requests under another user's ID.
     * @deny (get, update, delete) User cannot access friend requests under another user's ID.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/friendRequests/{requestId} {
          function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }
  }
}