/**
 * @fileoverview Firestore Security Rules for GoalForge.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model, ensuring that users can only access data associated with their own accounts.
 * Public read access is granted to a limited set of collections where appropriate (e.g., ChallengeTemplates).
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles; access is restricted to the owning user.
 * - /users/{userId}/goals/{goalId}: Stores goals for each user; access is restricted to the owning user.
 * - /users/{userId}/userChallenges/{userChallengeId}: Stores challenges assigned to each user; access is restricted to the owning user.
 * - /users/{userId}/friendRequests/{requestId}: Stores friend requests sent to a user in a subcollection; access is restricted to the owning user.
 * - /challengeTemplates/{challengeTemplateId}: Stores challenge templates, which are publicly readable.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - ChallengeTemplates are publicly readable but not writable.
 * - All write operations are validated against the authenticated user's UID to prevent unauthorized data modification.
 *
 * Denormalization for Authorization:
 *  - The 'friendRequests' collection is nested under each user's document. This ensures that only the recipient can manage their friend requests, simplifying security rules and improving performance.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     * @return {bool} True if the request is authenticated, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     * @param {string} userId The user ID to compare against the authenticated user's UID.
     * @return {bool} True if the user IDs match, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of an existing document.
     * @param {string} userId The user ID to compare against the authenticated user's UID.
     * @return {bool} True if the user IDs match and the document exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Defines security rules for user documents.
     * @path /users/{userId}
     * @allow (create) - Authenticated user creates their own user document.
     * @allow (get, update, delete) - Authenticated user accesses their own user document.
     * @deny (create) - Mismatched user ID in the path and auth.
     * @principle Enforces document ownership for all operations on user documents.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Defines security rules for goals associated with a user.
     * @path /users/{userId}/goals/{goalId}
     * @allow (create, get, update, delete) - Authenticated user manages their own goals.
     * @deny (create, get, update, delete) - Access by a different user.
     * @principle Restricts goal access to the owning user.
     */
    match /users/{userId}/goals/{goalId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Defines security rules for challenge templates.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (get, list) - Public read access to challenge templates.
     * @deny (create, update, delete) - No write access allowed.
     * @principle Allows public read access for challenge templates.
     */
    match /challengeTemplates/{challengeTemplateId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Defines security rules for user challenges assigned to a user.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (create, get, update, delete) - Authenticated user manages their own challenges.
     * @deny (create, get, update, delete) - Access by a different user.
     * @principle Restricts challenge access to the owning user.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Defines security rules for friend requests sent to a user.
     * @path /users/{userId}/friendRequests/{requestId}
     * @allow (create, get, update, delete) - Authenticated user manages their own friend requests.
     * @deny (create, get, update, delete) - Access by a different user.
     * @principle Restricts access to friend requests to the receiving user.
     */
    match /users/{userId}/friendRequests/{requestId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}