/**
 * @fileoverview Firestore Security Rules for GoalForge application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Users can only access
 * and modify data associated with their own user ID, with the exception of
 * publicly readable challenge templates.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only to the user.
 * - /users/{userId}/goals/{goalId}: Stores goals, accessible only to the user.
 * - /challengeTemplates/{challengeTemplateId}: Stores public challenge templates, readable by all users.
 * - /users/{userId}/userChallenges/{userChallengeId}: Stores user challenges, accessible only to the user.
 * - /users/{userId}/friendRequests/{requestId}: Stores friend requests, only accessible to the receiving user.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Challenge templates are publicly readable but not writable.
 * - All write operations are carefully restricted to prevent unauthorized data modification.
 * - Data consistency checks are performed on create operations to ensure
 *   relational integrity (e.g., userId in the path must match userId in the
 *   document).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Rule for the root of the database.  This prevents anyone from writing to the root.
     * @path /databases/{database}/documents
     * @allow (create) User with UID 'testUID' can't create a document at the root
     * @deny (create) Any user can't create a document at the root.
     * @principle Root access is denied.
     */
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rule for user profiles. Users can only read/write their own profile.
     * @path /users/{userId}
     * @allow (create) User with UID 'testUID' can create their own profile.
     * @allow (get) User with UID 'testUID' can get their own profile.
     * @deny (create) User with UID 'otherUID' can't create a profile for 'testUID'.
     * @deny (update) User with UID 'otherUID' can't update the profile for 'testUID'.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // User listing is not permitted.
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rule for goals associated with a specific user. Only the owning user can access these goals.
     * @path /users/{userId}/goals/{goalId}
     * @allow (create) User with UID 'testUID' can create a goal for themselves.
     * @allow (get) User with UID 'testUID' can get their own goal.
     * @deny (create) User with UID 'otherUID' can't create a goal for user 'testUID'.
     * @deny (update) User with UID 'otherUID' can't update the goal for user 'testUID'.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/goals/{goalId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rule for challenge templates. Accessible by all users to fetch and populate challenges.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (get) Any user can get a challenge template.
     * @allow (list) Any user can list challenge templates.
     * @deny (create) No user can create a challenge template.
     * @deny (update) No user can update a challenge template.
     * @principle Public read access for challenge templates, with no write access.
     */
    match /challengeTemplates/{challengeTemplateId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Rule for user challenges assigned to a specific user. Enforces path-based ownership.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (create) User with UID 'testUID' can create a challenge for themselves.
     * @allow (get) User with UID 'testUID' can get their own challenge.
     * @deny (create) User with UID 'otherUID' can't create a challenge for user 'testUID'.
     * @deny (update) User with UID 'otherUID' can't update the challenge for user 'testUID'.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rule for friend requests sent to a user in a subcollection. Users can only manage requests sent to them.
     * @path /users/{userId}/friendRequests/{requestId}
     * @allow (create) User with UID 'testUID' can create a friend request for themselves (as the receiver).
     * @allow (get) User with UID 'testUID' can get a friend request sent to them.
     * @allow (list) User with UID 'testUID' can list friend requests sent to them.
     * @deny (create) User with UID 'otherUID' can't create a friend request for user 'testUID'.
     * @deny (update) User with UID 'otherUID' can't update the friend request for user 'testUID'.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/friendRequests/{requestId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.receiverId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.receiverId == userId;
      allow delete: if isExistingOwner(userId);
    }
  }
}