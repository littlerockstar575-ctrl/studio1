/**
 * @file Firestore Security Rules
 * @core Philosophy: This ruleset enforces a strict user-ownership model for user-specific data and allows public read access to challenge templates.
 * @data Structure:
 *   - /users/{userId}: User profiles, accessible only by the owning user.
 *   - /users/{userId}/goals/{goalId}: Goals, accessible only by the owning user.
 *   - /challengeTemplates/{challengeTemplateId}: Challenge templates, publicly readable.
 *   - /users/{userId}/userChallenges/{userChallengesId}: User-specific challenges, accessible only by the owning user.
 *   - /users/{userId}/friendRequests/{requestId}: Friend requests sent to a user, accessible only by the receiving user.
 * @key Security Decisions:
 *   - Users can only read/write their own data under their /users/{userId} path.
 *   - Challenge templates are publicly readable but not writable.
 *   - Listing of users is disallowed to prevent information disclosure.
 *   - Friend requests are managed in a user subcollection, with access limited to the receiving user.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces user-ownership for user profiles. Only the authenticated user can read or write their own profile.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their profile if request.auth.uid == 'user123'.
     * @allow (get) User with ID 'user123' can read their profile if request.auth.uid == 'user123'.
     * @allow (update) User with ID 'user123' can update their profile if request.auth.uid == 'user123'.
     * @allow (delete) User with ID 'user123' can delete their profile if request.auth.uid == 'user123'.
     * @deny (create) User with ID 'user456' cannot create a profile for 'user123'.
     * @deny (get) User with ID 'user456' cannot read the profile of 'user123'.
     * @deny (update) User with ID 'user456' cannot update the profile of 'user123'.
     * @deny (delete) User with ID 'user456' cannot delete the profile of 'user123'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Enforces user-ownership for goals. Only the authenticated user can read or write goals under their user ID.
     * @path /users/{userId}/goals/{goalId}
     * @allow (create) User with ID 'user123' can create a goal under their profile if request.auth.uid == 'user123'.
     * @allow (get) User with ID 'user123' can read their goal if request.auth.uid == 'user123'.
     * @allow (update) User with ID 'user123' can update their goal if request.auth.uid == 'user123'.
     * @allow (delete) User with ID 'user123' can delete their goal if request.auth.uid == 'user123'.
     * @deny (create) User with ID 'user456' cannot create a goal for 'user123'.
     * @deny (get) User with ID 'user456' cannot read the goal of 'user123'.
     * @deny (update) User with ID 'user456' cannot update the goal of 'user123'.
     * @deny (delete) User with ID 'user456' cannot delete the goal of 'user123'.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/goals/{goalId} {
       function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Allows public read access to challenge templates. No write access is allowed.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (get) Any user can read a challenge template.
     * @allow (list) Any user can list challenge templates.
     * @deny (create) No user can create a challenge template through the client.
     * @deny (update) No user can update a challenge template through the client.
     * @deny (delete) No user can delete a challenge template through the client.
     * @principle Public read with no write access.
     */
    match /challengeTemplates/{challengeTemplateId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Enforces user-ownership for user challenges. Only the authenticated user can read or write challenges under their user ID.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (create) User with ID 'user123' can create a challenge under their profile if request.auth.uid == 'user123'.
     * @allow (get) User with ID 'user123' can read their challenge if request.auth.uid == 'user123'.
     * @allow (update) User with ID 'user123' can update their challenge if request.auth.uid == 'user123'.
     * @allow (delete) User with ID 'user123' can delete their challenge if request.auth.uid == 'user123'.
     * @deny (create) User with ID 'user456' cannot create a challenge for 'user123'.
     * @deny (get) User with ID 'user456' cannot read the challenge of 'user123'.
     * @deny (update) User with ID 'user456' cannot update the challenge of 'user123'.
     * @deny (delete) User with ID 'user456' cannot delete the challenge of 'user123'.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }
    
    /**
     * @description Enforces user-ownership for friend requests. Only the user who is the receiver of the friend request can manage their own requests.
     * @path /users/{userId}/friendRequests/{requestId}
     * @allow (create) User can create a friend request to their id
     * @allow (get) User can get a friend request to their id
     * @allow (update) User can update a friend request to their id
     * @allow (delete) User can delete a friend request to their id
     * @deny (create) User cannot create a friend request for another user.
     * @deny (get) User cannot get a friend request for another user.
     * @deny (update) User cannot update a friend request for another user.
     * @deny (delete) User cannot delete a friend request for another user.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/friendRequests/{requestId} {
       function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }
  }
}