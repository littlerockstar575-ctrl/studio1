/**
 * @fileoverview Firestore Security Rules for GoalForge.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model, ensuring that users can only access their own data.
 * Public read access is granted to challenge templates, but write access is restricted.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, secured by user ID.
 * - /users/{userId}/goals/{goalId}: Stores goals, secured by user ID.
 * - /challengeTemplates/{challengeTemplateId}: Stores public challenge templates.
 * - /users/{userId}/userChallenges/{userChallengeId}: Stores user-specific challenges.
 * - /users/{userId}/friendRequests/{requestId}: Stores friend requests for a specific user.
 *
 * Key Security Decisions:
 * - Users can only read and write their own user data and associated subcollections (goals, userChallenges, friendRequests).
 * - Listing of the /users collection is disallowed to prevent enumeration.
 * - Challenge templates are publicly readable but not writable by regular users.
 *
 * Denormalization for Authorization:
 *  - The `userId` is used within subcollections to tie the data to the owner,
 *    enabling path-based authorization checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces that only the authenticated user can access their own user document.
     * @path /users/{userId}
     * @allow (get, create, update, delete, list) if the user is signed in and the requested userId matches the authenticated user's UID.
     * @deny (get, create, update, delete, list) if the user is not signed in or the userId does not match the authenticated user's UID.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      // Prevent listing all users
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces that only the authenticated user can access their own goal document.
     * @path /users/{userId}/goals/{goalId}
     * @allow (get, create, update, delete, list) if the user is signed in and the requested userId matches the authenticated user's UID.
     * @deny (get, create, update, delete, list) if the user is not signed in or the userId does not match the authenticated user's UID.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/goals/{goalId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to challenge templates, but restricts write access.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (get, list) to all users.
     * @deny (create, update, delete) to all users.
     * @principle Grants public read access for challenge templates.
     */
    match /challengeTemplates/{challengeTemplateId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Enforces that only the authenticated user can access their own user challenge documents.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (get, create, update, delete, list) if the user is signed in and the requested userId matches the authenticated user's UID.
     * @deny (get, create, update, delete, list) if the user is not signed in or the userId does not match the authenticated user's UID.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces that only the user receiving the friend request can manage it.
     * @path /users/{userId}/friendRequests/{requestId}
     * @allow (get, create, update, delete, list) if the user is signed in and the requested userId matches the authenticated user's UID.
     * @deny (get, create, update, delete, list) if the user is not signed in or the userId does not match the authenticated user's UID.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/friendRequests/{requestId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.receiverId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.receiverId == resource.data.receiverId;
      allow delete: if isExistingOwner(userId);
    }
  }
}