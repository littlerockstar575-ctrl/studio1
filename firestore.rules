/**
 * @fileoverview Firestore Security Rules for GoalForge.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for personal data while allowing public read access to shared data.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only by the owning user.
 * - /users/{userId}/goals/{goalId}: Goals specific to a user, accessible only by the owning user.
 * - /challengeTemplates/{challengeTemplateId}: Publicly readable templates for challenges.  Write access not explicitly defined.
 * - /users/{userId}/userChallenges/{userChallengeId}: User-specific challenges, accessible only by the owning user.
 * - /users/{userId}/friendRequests/{requestId}: Friend requests for a user, accessible only by the receiving user.
 *
 * Key Security Decisions:
 * - User listing is disallowed for privacy.
 * - Challenge templates are publicly readable.
 *
 * Denormalization for Authorization:
 *  - FriendRequests are stored in a subcollection of the receiving user to simplify authorization. This avoids needing to query a root-level collection and filter based on receiverId.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects user profiles. Only the user can read/write their own profile.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' creates their profile.
     * @allow (get) User with ID 'user123' reads their profile.
     * @deny (update) User with ID 'user456' tries to update user 'user123' profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false; // User listing is not permitted

      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && resource.data.id == userId;
      allow delete: if isExistingOwner(userId);

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
    }

    /**
     * @description Protects goals associated with a specific user. Only the owning user can access these goals.
     * @path /users/{userId}/goals/{goalId}
     * @allow (create) User with ID 'user123' creates a goal for themselves.
     * @allow (get) User with ID 'user123' reads a goal they own.
     * @deny (update) User with ID 'user456' tries to update user 'user123' goal.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/goals/{goalId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isOwner(userId) && resource.data.userId == userId;
      allow delete: if isExistingOwner(userId);

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
    }

    /**
     * @description Defines access rules for challenge templates, which are publicly readable. Write permissions are not defined and thus denied.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (get) Any user can read a challenge template.
     * @deny (create) No one can create challenge templates through client code.
     * @principle Allows public read access for challenge templates.
     */
    match /challengeTemplates/{challengeTemplateId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Protects user challenges assigned to a specific user. Enforces path-based ownership, restricting access to only the owning user.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (create) User with ID 'user123' creates a challenge for themselves.
     * @allow (get) User with ID 'user123' reads a challenge they own.
     * @deny (update) User with ID 'user456' tries to update user 'user123' challenge.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isOwner(userId) && resource.data.userId == userId;
      allow delete: if isExistingOwner(userId);

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
    }

    /**
     * @description Stores friend requests sent to a user in a subcollection. Security rules enforce that users can only manage requests sent to them.
     * @path /users/{userId}/friendRequests/{requestId}
     * @allow (create) User can create a friend request for themselves.
     * @allow (get) User can read their own friend requests.
     * @deny (update) User cannot update friend requests that are not theirs.
     */
     match /users/{userId}/friendRequests/{requestId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) && request.resource.data.receiverId == userId;
      allow update: if isOwner(userId) && resource.data.receiverId == userId;
      allow delete: if isExistingOwner(userId);

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
    }
  }
}