/**
 * @fileoverview Firestore Security Rules for GoalForge.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for personal data, while allowing public read access to shared resources.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only by the owning user.
 * - /users/{userId}/goals/{goalId}: Goals, accessible only by the owning user.
 * - /challengeTemplates/{challengeTemplateId}: Public challenge templates, readable by all.
 * - /users/{userId}/userChallenges/{userChallengeId}: User-specific challenges, accessible only by the owning user.
 * - /users/{userId}/friendRequests/{requestId}: Friend requests sent to a user, accessible only by the receiving user.
 *
 * Key Security Decisions:
 * - Users can only access their own data under /users/{userId}/...
 * - Challenge templates are publicly readable.
 * - Friend requests are managed in a user-specific subcollection for better security and scalability.
 *
 * Denormalization for Authorization:
 *  - FriendRequest documents require `senderId` and `receiverId` fields matching the respective user IDs to ensure proper authorization and prevent spoofing.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces access control for user profiles.
     * @path /users/{userId}
     * @allow (read, write) User with matching UID can access their own profile.
     * @deny (read, write) User cannot access another user's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Enforces access control for goals associated with a user.
     * @path /users/{userId}/goals/{goalId}
     * @allow (read, write) User with matching UID can access their own goals.
     * @deny (read, write) User cannot access another user's goals.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/goals/{goalId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows public read access to challenge templates.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (read) Any user can read challenge templates.
     * @deny (write) Only the backend can create, update, or delete challenge templates (not implemented in these rules).
     * @principle Grants public read access to shared resources, restricts write access.
     */
    match /challengeTemplates/{challengeTemplateId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Enforces access control for user challenges assigned to a user.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (read, write) User with matching UID can access their own challenges.
     * @deny (read, write) User cannot access another user's challenges.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Enforces access control for friend requests sent to a user.
     * @path /users/{userId}/friendRequests/{requestId}
     * @allow (read, write) User with matching UID can access their own friend requests.
     * @deny (read, write) User cannot access another user's friend requests.
     * @principle Enforces document ownership for all operations, validates sender and receiver IDs.
     */
    match /users/{userId}/friendRequests/{requestId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      allow list, get: if isOwner(userId);
      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId == userId;
      allow update: if false;
      allow delete: if isOwner(userId);
    }
  }
}