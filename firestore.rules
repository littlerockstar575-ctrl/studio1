/**
 * @file Firestore Security Rules
 * @core_philosophy This ruleset enforces a strict user-ownership model for most data,
 * with public read access to challenge templates.  All write operations require
 * authentication, and data is organized hierarchically under the `/users/{userId}`
 * path to simplify security rules.
 * @data_structure
 *   - /users/{userId}: User profiles, owned by the user.
 *   - /users/{userId}/goals/{goalId}: Goals associated with a user.
 *   - /challengeTemplates/{challengeTemplateId}: Publicly readable challenge templates.
 *   - /users/{userId}/userChallenges/{userChallengeId}: User-specific challenges.
 *   - /users/{userId}/friendRequests/{requestId}: Friend requests sent to a user.
 * @key_security_decisions
 *   - User listing is disallowed to protect user privacy.
 *   - Challenge templates are publicly readable.
 *   - All other data is strictly user-owned.
 *   - The rules are structured to minimize reads and maximize performance by denormalizing data where necessary for authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects user profiles, ensuring only the owner can read and write their own data.
     * @path /users/{userId}
     * @allow (create) User A can create their profile if request.auth.uid == userId.
     * @allow (get, update, delete) User A can read/update/delete their profile if request.auth.uid == userId.
     * @deny (create) User A cannot create a profile with a userId that does not match their request.auth.uid.
     * @deny (get, update, delete) User A cannot read/update/delete User B's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Protects goals, ensuring only the owner can read and write their own goals.
     * @path /users/{userId}/goals/{goalId}
     * @allow (create) User A can create a goal under their profile if request.auth.uid == userId.
     * @allow (get, update, delete) User A can read/update/delete a goal under their profile if request.auth.uid == userId.
     * @deny (create) User A cannot create a goal under User B's profile.
     * @deny (get, update, delete) User A cannot read/update/delete a goal under User B's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/goals/{goalId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to challenge templates.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (get, list) Any user can read challenge templates.
     * @deny (create, update, delete) No user can create, update, or delete challenge templates.
     * @principle Allows public read access to a collection.
     */
    match /challengeTemplates/{challengeTemplateId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Protects user challenges, ensuring only the owner can read and write their own challenges.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (create) User A can create a challenge under their profile if request.auth.uid == userId.
     * @allow (get, update, delete) User A can read/update/delete a challenge under their profile if request.auth.uid == userId.
     * @deny (create) User A cannot create a challenge under User B's profile.
     * @deny (get, update, delete) User A cannot read/update/delete a challenge under User B's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

     /**
      * @description Protects friend requests, ensuring users can only manage requests sent to them.
      * @path /users/{userId}/friendRequests/{requestId}
      * @allow (create) User A can create a friend request to User B under User B's profile if request.auth.uid == senderId.
      * @allow (get, update, delete) User B can read/update/delete friend requests sent to them.
      * @deny (create) User A cannot create a friend request under User C's profile.
      * @deny (get, update, delete) User A cannot read/update/delete friend requests sent to User B.
      * @principle Enforces document ownership for writes.
      */
    match /users/{userId}/friendRequests/{requestId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
       allow create: if request.auth != null && request.resource.data.receiverId == userId && request.auth.uid == request.resource.data.senderId;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}