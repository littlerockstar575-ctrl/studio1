/**
 * @fileoverview Firestore Security Rules for GoalForge.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model.  Users can only
 * access their own data, preventing unauthorized access to other users'
 * information.  Challenge templates are publicly readable, but not writable.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles.
 * - /users/{userId}/goals/{goalId}: Stores goals for each user.
 * - /challengeTemplates/{challengeTemplateId}: Stores global challenge templates.
 * - /users/{userId}/userChallenges/{userChallengeId}: Stores user-specific challenges.
 * - /users/{userId}/friendRequests/{requestId}: Stores friend requests for each user.
 *
 * Key Security Decisions:
 * - User listing is explicitly denied.
 * - Challenge templates are publicly readable, but only the backend can create, update, or delete them.  (Not yet implemented here.)
 * - All user-owned data is nested under the /users/{userId} collection.
 * - Friend requests are managed within user-specific subcollections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     * @param {string} userId - The user ID to compare against.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user owns the existing document.
     * @param {string} userId - The user ID to compare against.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Enforces user-ownership for profiles.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user123' can create their own profile at /users/user123.
     * @allow (get, update, delete) - User with UID 'user123' can read/write their own profile at /users/user123.
     * @deny (create) - User with UID 'user123' cannot create a profile at /users/user456.
     * @deny (get, update, delete) - User with UID 'user123' cannot read/write profile at /users/user456.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces user-ownership for goals.
     * @path /users/{userId}/goals/{goalId}
     * @allow (create) - User with UID 'user123' can create a goal at /users/user123/goals/goal456.
     * @allow (get, update, delete) - User with UID 'user123' can read/write their own goal at /users/user123/goals/goal456.
     * @deny (create) - User with UID 'user123' cannot create a goal at /users/user456/goals/goal456.
     * @deny (get, update, delete) - User with UID 'user123' cannot read/write goal at /users/user456/goals/goal456.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/goals/{goalId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to challenge templates, but restricts write access.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (get, list) - Any user can read challenge templates.
     * @deny (create, update, delete) - No user can create, update, or delete challenge templates through the client.
     * @principle Allows public read access with owner-only writes (backend only).
     */
    match /challengeTemplates/{challengeTemplateId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Secure backend writes only
    }

    /**
     * @description Enforces user-ownership for user challenges.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (create) - User with UID 'user123' can create a challenge at /users/user123/userChallenges/challenge456.
     * @allow (get, update, delete) - User with UID 'user123' can read/write their own challenge at /users/user123/userChallenges/challenge456.
     * @deny (create) - User with UID 'user123' cannot create a challenge at /users/user456/userChallenges/challenge456.
     * @deny (get, update, delete) - User with UID 'user123' cannot read/write challenge at /users/user456/userChallenges/challenge456.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

     /**
     * @description Enforces user-ownership for friend requests.
     * @path /users/{userId}/friendRequests/{requestId}
     * @allow (create) - User with UID 'user123' can create a friend request to /users/user123/friendRequests/request456.
     * @allow (get, update, delete) - User with UID 'user123' can read/write their own friend request at /users/user123/friendRequests/request456.
     * @deny (create) - User with UID 'user123' cannot create a friend request to /users/user456/friendRequests/request456.
     * @deny (get, update, delete) - User with UID 'user123' cannot read/write friend request at /users/user456/friendRequests/request456.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/friendRequests/{requestId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if request.resource.data.receiverId == userId && isSignedIn();
      allow update: if isExistingOwner(userId) && request.resource.data.receiverId == resource.data.receiverId;
      allow delete: if isExistingOwner(userId);
    }
  }
}