/**
 * @file Overview
 * This ruleset enforces a strict user-ownership model, ensuring users can only access their own data.
 * All data is nested under /users/{userId}, with subcollections for goals and user-challenges.
 * Challenge templates are public read-only.
 * Friend Requests is an unknown entity and is being denied by default.
 *
 * @core-philosophy Strict user-ownership for personal data; public read access for shared templates.
 * @data-structure
 *   - /users/{userId}: User profiles
 *   - /users/{userId}/goals/{goalId}: User goals
 *   - /challengeTemplates/{challengeTemplateId}: Public challenge templates
 *   - /users/{userId}/userChallenges/{userChallengeId}: User challenges
 * @key-security-decisions
 *   - User listing is implicitly denied.
 *   - Challenge templates are publicly readable but not writable.
 *   - All write operations on user-owned data require authentication and ownership validation.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user ID matches the authenticated user's UID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user ID matches the authenticated user's UID and the resource exists.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Enforces that only the authenticated user can access their own profile.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' creates their profile with matching userId.
     * @allow (get) User with ID 'user123' reads their own profile.
     * @allow (update) User with ID 'user123' updates their own profile.
     * @allow (delete) User with ID 'user123' deletes their own profile.
     * @deny (create) User with ID 'user123' attempts to create profile for 'user456'.
     * @deny (get) User with ID 'user123' attempts to read profile of 'user456'.
     * @principle Enforces document ownership for writes; restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces that only the authenticated user can access their own goals.
     * @path /users/{userId}/goals/{goalId}
     * @allow (create) User with ID 'user123' creates a goal with matching userId.
     * @allow (get) User with ID 'user123' reads their own goal.
     * @allow (update) User with ID 'user123' updates their own goal.
     * @allow (delete) User with ID 'user123' deletes their own goal.
     * @deny (create) User with ID 'user123' attempts to create a goal for 'user456'.
     * @deny (get) User with ID 'user123' attempts to read goal of 'user456'.
     * @principle Enforces document ownership for writes; restricts access to a user's own data tree.
     */
    match /users/{userId}/goals/{goalId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows any user to read challenge templates, but prevents modifications.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (get) Any user can read challenge templates.
     * @allow (list) Any user can list challenge templates.
     * @deny (create) No user can create challenge templates through client-side rules.
     * @deny (update) No user can update challenge templates through client-side rules.
     * @deny (delete) No user can delete challenge templates through client-side rules.
     * @principle Public read access; no write access allowed.
     */
    match /challengeTemplates/{challengeTemplateId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Enforces that only the authenticated user can access their own user challenges.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (create) User with ID 'user123' creates a user challenge with matching userId.
     * @allow (get) User with ID 'user123' reads their own user challenge.
     * @allow (update) User with ID 'user123' updates their own user challenge.
     * @allow (delete) User with ID 'user123' deletes their own user challenge.
     * @deny (create) User with ID 'user123' attempts to create a user challenge for 'user456'.
     * @deny (get) User with ID 'user123' attempts to read user challenge of 'user456'.
     * @principle Enforces document ownership for writes; restricts access to a user's own data tree.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }
      /**
       * @description Unknown data structure. Denying all access.
       * @path /friendRequests
       * @deny (get)  No user can get data.
       * @deny (list)  No user can list data.
       * @deny (create)  No user can create data.
       * @deny (update)  No user can update data.
       * @deny (delete)  No user can delete data.
       * @principle Unknown data structure.
       */
    match /friendRequests {
        allow get: if false;
        allow list: if false;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }
  }
}