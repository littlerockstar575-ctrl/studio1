/**
 * @file Firestore Security Rules
 * @core_philosophy This ruleset enforces a strict user-ownership model for user profiles, goals, and user challenges. FriendRequests are managed within user-specific subcollections. ChallengeTemplates are publicly readable.
 * @data_structure
 *   /users/{userId} : User profiles
 *   /users/{userId}/goals/{goalId} : User's goals
 *   /challengeTemplates/{challengeTemplateId} : Challenge templates
 *   /users/{userId}/userChallenges/{userChallengeId} : User's assigned challenges
 *   /users/{userId}/friendRequests/{requestId} : Friend requests sent to a user
 * @key_security_decisions
 *   - User listing is disallowed.
 *   - Challenge templates are publicly readable but not writable.
 *   - All user-owned data (profiles, goals, challenges) is only accessible by the owning user.
 *   - Friend requests are managed in user-specific subcollections, ensuring users can only manage requests sent to them.
 *
 * @denormalization_for_authorization Not applicable in this ruleset.
 * @structural_segregation Not applicable in this ruleset.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces access control for user profiles. Only the authenticated user can read or write their own profile.
     * @path /users/{userId}
     * @allow (get, list): Authenticated user can read their own profile.
     * @allow (create, update, delete): Authenticated user can modify their own profile.
     * @deny (get, list): Any other user attempting to read this profile.
     * @deny (create, update, delete): Any other user attempting to modify this profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Enforces access control for goals. Only the owning user can read or write their goals.
     * @path /users/{userId}/goals/{goalId}
     * @allow (get, list): Authenticated user can read their own goals.
     * @allow (create, update, delete): Authenticated user can modify their own goals.
     * @deny (get, list): Any other user attempting to read this goal.
     * @deny (create, update, delete): Any other user attempting to modify this goal.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/goals/{goalId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Allows public read access to challenge templates. Write access is denied to all.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (get, list): Any user can read challenge templates.
     * @deny (create, update, delete): No user can create, update, or delete challenge templates.
     * @principle Allows public read access but restricts write access.
     */
    match /challengeTemplates/{challengeTemplateId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Enforces access control for user challenges. Only the owning user can read or write their challenges.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (get, list): Authenticated user can read their own challenges.
     * @allow (create, update, delete): Authenticated user can modify their own challenges.
     * @deny (get, list): Any other user attempting to read this challenge.
     * @deny (create, update, delete): Any other user attempting to modify this challenge.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Enforces access control for friend requests. Users can only manage requests sent to them.
     * @path /users/{userId}/friendRequests/{requestId}
     * @allow (get, list): The receiving user can read friend requests sent to them.
     * @allow (create, update, delete): The receiving user can manage friend requests sent to them.
     * @deny (get, list): Any other user attempting to read friend requests sent to this user.
     * @deny (create, update, delete): Any other user attempting to manage friend requests sent to this user.
     * @principle Enforces document ownership for friend requests, ensuring users can only manage requests sent to them.
     */
    match /users/{userId}/friendRequests/{requestId} {
     function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
       allow get: if isSignedIn() && isOwner(userId);
       allow list: if false;
       allow create: if isSignedIn() && isOwner(userId);
       allow update: if isSignedIn() && isOwner(userId);
       allow delete: if isSignedIn() && isOwner(userId);
    }
  }
}