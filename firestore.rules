/**
 * @fileoverview Firestore Security Rules for GoalForge application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Users can only
 * access their own data, with the exception of publicly accessible
 * challenge templates.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, owned by the user.
 * - /users/{userId}/goals/{goalId}: Goals associated with a specific user.
 * - /challengeTemplates/{challengeTemplateId}: Challenge templates, publicly readable.
 * - /users/{userId}/userChallenges/{userChallengeId}: User-specific challenges.
 * - /users/{userId}/friendRequests/{requestId}: Friend requests sent to a user.
 *
 * Key Security Decisions:
 * - Users can only create, read, update, and delete their own data.
 * - Challenge templates are publicly readable but not writable.
 * - Listing other users' data is disallowed.
 *
 * Denormalization for Authorization:
 * - Friend requests include both senderId and receiverId, allowing for
 *   validation of both the sender and receiver when creating requests.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles. Only the user can read/write their own profile.
     * @path /users/{userId}
     * @allow (create, update, delete, get, list) if the user's UID matches the userId.
     * @deny (create, update, delete, get, list) if the user's UID does not match the userId.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Secure goals associated with a specific user. Only the owning user can access these goals.
     * @path /users/{userId}/goals/{goalId}
     * @allow (create, update, delete, get, list) if the user's UID matches the userId.
     * @deny (create, update, delete, get, list) if the user's UID does not match the userId.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/goals/{goalId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Secure challenge templates. Accessible by all users for reading, but not for writing.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (get, list) to all users.
     * @deny (create, update, delete) to all users.
     * @principle Allows public read access for challenge templates, restricts write access.
     */
    match /challengeTemplates/{challengeTemplateId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Secure user challenges assigned to a specific user. Enforces path-based ownership.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (create, update, delete, get, list) if the user's UID matches the userId.
     * @deny (create, update, delete, get, list) if the user's UID does not match the userId.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Secure friend requests sent to a user in a subcollection.
     * @path /users/{userId}/friendRequests/{requestId}
     * @allow The receiver (userId) to list or read their own friend requests, filtering for pending requests.
     * @allow Another user (the sender) to create a request, enforcing that the senderId matches the auth UID and the receiverId matches the userId path.
     * @allow The receiver (userId) to update or delete requests they received.
     * @deny Any other operations.
     * @principle Enforces document ownership and request validation for friend requests.
     */
    match /users/{userId}/friendRequests/{requestId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }

      // Allow the receiver (userId) to list or read their own friend requests
      allow get, list: if isOwner(userId);

      // Allow another user (the sender) to create a request
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid && request.resource.data.receiverId == userId && request.resource.data.status == 'pending';

      // Allow the receiver (userId) to update or delete requests they received
      allow update, delete: if isOwner(userId) && resource.data.receiverId == userId;
    }
  }
}