/**
 * @fileoverview Firestore Security Rules for GoalForge application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Users can only access their own data, with the exception of challenge templates which are publicly readable.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only by the user.
 * - /users/{userId}/goals/{goalId}: Goals specific to a user, accessible only by the user.
 * - /challengeTemplates/{challengeTemplateId}: Publicly readable challenge templates.
 * - /users/{userId}/userChallenges/{userChallengeId}: User-specific challenges, accessible only by the user.
 *
 * Key Security Decisions:
 * - Users can only create their own profile.
 * - Users cannot list all users.
 * - Challenge Templates are publicly readable.
 * - All other collections are strictly user-owned.
 *
 * Denormalization for Authorization:
 * This ruleset leverages path-based authorization to avoid costly `get()` calls. User IDs are embedded in the document paths, allowing rules to easily verify ownership using `request.auth.uid`.
 *
 * Structural Segregation:
 * Public challenge templates are stored in a separate top-level collection to avoid mixing public and private data within the same collection, simplifying read operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (create) Authenticated user creates their own profile.
     * @allow (get, update, delete) Authenticated user accesses their own profile.
     * @deny (create) Authenticated user attempts to create a profile for another user.
     * @deny (get, update, delete) Authenticated user attempts to access another user's profile.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree, validates relational integrity between documents.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow get: if isOwner(userId);
      allow list: if false;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to goals associated with a specific user.
     * @path /users/{userId}/goals/{goalId}
     * @allow (create) Authenticated user creates a goal under their profile.
     * @allow (get, update, delete) Authenticated user accesses their own goal.
     * @deny (create) Authenticated user attempts to create a goal for another user.
     * @deny (get, update, delete) Authenticated user attempts to access another user's goal.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree, validates relational integrity between documents.
     */
    match /users/{userId}/goals/{goalId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to challenge templates.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (get, list) All users can read challenge templates.
     * @deny (create, update, delete) No user can create, update, or delete challenge templates (admin only).
     * @principle Allows public read access to challenge templates.
     */
    match /challengeTemplates/{challengeTemplateId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to user challenges assigned to a specific user.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (create) Authenticated user creates a user challenge under their profile.
     * @allow (get, update, delete) Authenticated user accesses their own user challenge.
     * @deny (create) Authenticated user attempts to create a user challenge for another user.
     * @deny (get, update, delete) Authenticated user attempts to access another user's user challenge.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree, validates relational integrity between documents.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }
  }
}