/**
 * @file Firestore Security Rules
 * @core_philosophy This ruleset enforces a user-ownership model for most data,
 *  with public read access for some shared resources.
 * @data_structure
 *  - /users/{userId}: User profile data, owned by the user.
 *  - /users/{userId}/goals/{goalId}: Goals for each user, owned by the user.
 *  - /challengeTemplates/{challengeTemplateId}: Publicly accessible challenge templates.
 *  - /users/{userId}/userChallenges/{userChallengeId}: User-specific challenges, owned by the user.
 *  - /users/{userId}/friendRequests/{requestId}: Friend requests sent to a user, owned by the receiving user.
 * @key_security_decisions
 *  - Users can only access their own data under /users/{userId}.
 *  - Challenge templates are publicly readable.
 *  - Friend Requests are managed in subcollections under the receiving user, enforcing ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) Signed-in user creates their own profile with matching UID.
     * @allow (get, list, update, delete) Signed-in user accesses their own profile with matching UID.
     * @deny (create) Signed-in user attempts to create a profile with a mismatched UID.
     * @deny (get, list, update, delete) Signed-in user attempts to access another user's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource.data != null;
      }

      allow get, list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to goal documents associated with a user.
     * @path /users/{userId}/goals/{goalId}
     * @allow (create) Signed-in user creates a goal under their own user ID.
     * @allow (get, list, update, delete) Signed-in user accesses their own goal.
     * @deny (create) Signed-in user attempts to create a goal under another user's ID.
     * @deny (get, list, update, delete) Signed-in user attempts to access another user's goal.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/goals/{goalId} {
       function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource.data != null;
      }
      allow get, list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to challenge template documents.
     * @path /challengeTemplates/{challengeTemplateId}
     * @allow (get, list) Any user can read challenge templates.
     * @deny (create, update, delete) No user can create, update, or delete challenge templates.
     * @principle Allows public read access for shared resources, restricts write access.
     */
    match /challengeTemplates/{challengeTemplateId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to user challenge documents associated with a user.
     * @path /users/{userId}/userChallenges/{userChallengeId}
     * @allow (create) Signed-in user creates a user challenge under their own user ID.
     * @allow (get, list, update, delete) Signed-in user accesses their own user challenge.
     * @deny (create) Signed-in user attempts to create a user challenge under another user's ID.
     * @deny (get, list, update, delete) Signed-in user attempts to access another user's user challenge.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/userChallenges/{userChallengeId} {
       function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource.data != null;
      }
      allow get, list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to friend request documents sent to a user.
     * @path /users/{userId}/friendRequests/{requestId}
     * @allow (create) Signed-in user can create a friend request for themselves. The receiverId should match the userId in the path.
     * @allow (get, list, update, delete) Signed-in user can manage friend requests sent to them.
     * @deny (create) Signed-in user attempts to create a friend request for another user.
     * @deny (get, list, update, delete) Signed-in user attempts to manage another user's friend requests.
     * @principle Enforces document ownership, ensuring users can only manage requests sent to them.
     */
    match /users/{userId}/friendRequests/{requestId} {
       function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource.data != null;
      }
      allow get, list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && request.auth.uid != null && request.auth.uid == userId;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}